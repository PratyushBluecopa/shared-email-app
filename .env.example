# Standalone dev only. In a deployed app these come from the host's
# Settings → Env Vars panel (envVars), which override this file.

# Bluecopa API
VITE_BLUECOPA_API_URL=
VITE_BLUECOPA_WORKSPACE_ID=
VITE_BLUECOPA_API_TOKEN=
VITE_BLUECOPA_USER_ID=

# Solution context (required by Input Table V2)
VITE_BLUECOPA_SOLUTION_ID=
VITE_BLUECOPA_SOLUTION_BRANCH=main
VITE_BLUECOPA_SOLUTION_BRANCH_TYPE=REMOTE

# Email account the inbox reads and sends from
VITE_BLUECOPA_EMAIL_ACCOUNT_ID=
VITE_BLUECOPA_EMAIL_ADDRESS=

# Input Table V2 tables
VITE_TABLE_EMAIL_DRAFT=
VITE_TABLE_EMAIL_TEMPLATE=
VITE_TABLE_SIGNATURE=

# Real-time updates (websocket)
VITE_WEBSOCKET=pusher
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=
VITE_PUSHER_AUTH_ENDPOINT=
VITE_EMAIL_WS_CHANNEL=
VITE_EMAIL_WS_EVENT_MESSAGE_NEW=
VITE_EMAIL_WS_EVENT_CONVERSATION_UPDATE=
